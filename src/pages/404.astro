---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Access Denied: 404 | Mayank Raj Jaiswal" 
  description="Error 404: Unauthenticated Endpoint Access. Origin routing table failed."
>
  <main class="flex-grow flex items-center justify-center min-h-[100dvh] bg-slate-950 text-emerald-500 p-6 font-mono selection:bg-emerald-900/50 selection:text-emerald-200">
    <!-- Retro Scanning Line Effect -->
    <div class="absolute inset-0 bg-radial-scanning pointer-events-none opacity-10"></div>

    <div class="max-w-2xl w-full bg-black/90 border-2 border-emerald-500/30 rounded-3xl p-6 sm:p-10 shadow-2xl shadow-emerald-500/5 relative overflow-hidden font-mono">
      
      <!-- Top Window Bar -->
      <div class="flex items-center justify-between border-b border-emerald-500/20 pb-4 mb-6">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500/30 border border-red-500/50"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/30 border border-yellow-500/50"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/30 border border-emerald-500/50"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-500/70 ml-2">Secure Directory Session</span>
        </div>
        <span class="text-xs font-bold text-red-500 animate-pulse uppercase tracking-wider">Access Alert</span>
      </div>

      <!-- Terminal Body Content -->
      <div class="space-y-4 font-mono text-sm sm:text-base leading-relaxed">
        <p class="text-red-500 font-bold tracking-wider mb-2">
          [CRITICAL ERROR] STATUS CODE: 404_ENDPOINT_NOT_FOUND
        </p>
        <p class="text-slate-400">
          <span class="text-emerald-400 font-bold">$</span> curl -I https://mayankrajjaiswal.com/unresolved-target
        </p>
        <div class="text-slate-500 border-l-2 border-emerald-500/20 pl-4 py-2 space-y-1 text-xs sm:text-sm">
          <p>[WARN] Initiating dynamic path lookup... failed.</p>
          <p>[WARN] Target resource does not map to active sitemap routers.</p>
          <p>[SYSTEM] Triggering directory traversal defense protocols.</p>
          <p>[SYSTEM] Request headers analyzed. Origin IP mapped.</p>
        </div>
        <p class="text-emerald-400 font-semibold pt-4">
          Unauthenticated Target Access. Handshake session terminated.
        </p>
      </div>

      <!-- Action Redirect Button -->
      <div class="mt-10 pt-6 border-t border-emerald-500/20 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <p class="text-[11px] text-slate-500 uppercase tracking-wider font-mono">
          Handshake Status: Awaiting Connection
        </p>
        <a 
          href="/" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-emerald-500/40 hover:bg-emerald-500/10 hover:border-emerald-400 text-sm font-bold text-emerald-400 tracking-wider shadow-md hover:shadow-lg hover:shadow-emerald-500/10 transition-all hover:-translate-y-0.5"
        >
          [ INITIALIZE SECURE HANDSHAKE ]
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Cyber Scanner Overlay Animation */
  .bg-radial-scanning {
    background: linear-gradient(
      to bottom,
      rgba(16, 185, 129, 0) 50%,
      rgba(16, 185, 129, 0.04) 50%,
      rgba(16, 185, 129, 0.04)
    );
    background-size: 100% 4px;
  }
</style>