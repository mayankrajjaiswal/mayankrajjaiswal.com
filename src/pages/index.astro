---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import Research from '../components/sections/Research.astro';
import SecuritySimulator from '../components/sections/SecuritySimulator.astro';
import RecentWriting from '../components/sections/RecentWriting.astro';
import Speaking from '../components/sections/Speaking.astro';
import Certifications from '../components/sections/Certifications.astro';
import Timeline from '../components/sections/Timeline.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout 
  title="Mayank Raj Jaiswal | Enterprise Security Architect" 
  description="Enterprise Security Architect specializing in Identity & Access Management, Cybersecurity, Artificial Intelligence, Cloud Security, and Enterprise Software Architecture."
  preloadImage="/images/mayank-portrait.jpg"
>
  <Header />
  <main id="main-content" tabindex="-1" class="flex-grow pt-16 outline-none">
    <Hero />
    <About />
    <Experience />
    <Projects />
    <Research />
    <SecuritySimulator />
    <RecentWriting />
    <Speaking />
    <Certifications />
    <Timeline />
    <Contact />
  </main>
  <Footer />
</Layout>
