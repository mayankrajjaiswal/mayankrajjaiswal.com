---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { caseStudies } from '../../data/case-studies';

export async function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mayankrajjaiswal.com/" },
    { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://mayankrajjaiswal.com/#projects" },
    { "@type": "ListItem", "position": 3, "name": study.title, "item": `https://mayankrajjaiswal.com/projects/${study.slug}/` }
  ]
};
---

<Layout
  title={`${study.title} | Case Study | Mayank Raj Jaiswal`}
  description={study.summary}
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <main id="main-content" tabindex="-1" class="flex-grow pt-32 pb-24 bg-white dark:bg-slate-950 outline-none">
    <article class="max-w-3xl mx-auto px-6">

      <a href="/#projects" class="inline-flex items-center min-h-[24px] py-1 gap-2 text-sm font-semibold text-blue-600 dark:text-blue-400 mb-6 hover:underline">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="5" y1="12" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Projects
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="px-2.5 py-1 text-xs font-semibold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded">
          {study.category}
        </span>
        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">{study.year}</span>
      </div>

      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-slate-50 mb-6 leading-tight">
        {study.title}
      </h1>

      <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed mb-10 pb-10 border-b border-slate-200/80 dark:border-slate-800/80">
        {study.summary}
      </p>

      <div class="space-y-12">
        <section>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-4">The Problem</h2>
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed">{study.problem}</p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-4">Constraints</h2>
          <ul class="space-y-3">
            {study.constraints.map(item => (
              <li class="flex items-start gap-3.5 text-sm sm:text-base text-slate-700 dark:text-slate-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 text-blue-500 shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-4">Approach</h2>
          <ul class="space-y-3">
            {study.approach.map(item => (
              <li class="flex items-start gap-3.5 text-sm sm:text-base text-slate-700 dark:text-slate-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 text-indigo-500 shrink-0" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-4">Outcome</h2>
          <ul class="space-y-3">
            {study.outcome.map(item => (
              <li class="flex items-start gap-3.5 text-sm sm:text-base text-slate-700 dark:text-slate-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-1 text-emerald-500 shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-4">Technologies</h2>
          <div class="flex flex-wrap gap-2">
            {study.technologies.map(tech => (
              <span class="px-3 py-1.5 text-xs font-semibold bg-slate-50 dark:bg-slate-950/60 text-slate-700 dark:text-slate-300 rounded-lg border border-slate-200/80 dark:border-slate-800/80 font-mono">
                {tech}
              </span>
            ))}
          </div>
        </section>

        {study.url && (
          <section>
            <a
              href={study.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-blue-600 text-white font-bold hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-500 transition-all hover:-translate-y-0.5 shadow-md hover:shadow-lg"
            >
              Visit Site
              <span class="sr-only"> (opens in a new tab)</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" x2="21" y1="14" y2="3"></line></svg>
            </a>
          </section>
        )}
      </div>

    </article>
  </main>
  <Footer />
</Layout>
