---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const lastUpdated = '2026-09-09';
---

<Layout
  title="Now | Mayank Raj Jaiswal"
  description="What Mayank Raj Jaiswal is currently focused on — Ph.D research, current role, and active projects."
>
  <Header />
  <main id="main-content" tabindex="-1" class="flex-grow pt-32 pb-24 bg-white dark:bg-slate-950 outline-none">
    <div class="max-w-3xl mx-auto px-6">

      <div class="mb-10">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-slate-50 mb-4">
          Now
        </h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm font-medium">
          Last updated {new Date(lastUpdated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}.
        </p>
      </div>

      <div class="space-y-10">
        <section>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-3">Work</h2>
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
            Senior Technical Lead for Cybersecurity at Thales Group, architecting IAM
            platforms (EPS, MSM, IdCloud) and leading Cyber Resilience Act readiness
            work across enterprise identity products.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-3">Research</h2>
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
            Pursuing a Ph.D. focused on Artificial Intelligence in Cybersecurity —
            reading into adaptive authentication, AI-driven threat detection, and the
            security implications of agentic AI systems.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-3">Writing</h2>
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
            Publishing technical deep-dives on identity, cryptography, and AI security
            at <a href="/blog/" class="text-blue-600 dark:text-blue-400 underline hover:no-underline">/blog</a> —
            covering topics like post-quantum PKI migration, FIDO2/passkeys, and
            threat modeling for LLM pipelines.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-50 mb-3">Community</h2>
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
            Continuing to mentor engineers and students in security architecture, and
            growing <a href="https://www.thecybernews.org/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 underline hover:no-underline">TheCyberNews</a>,
            a cybersecurity awareness initiative.
          </p>
        </section>
      </div>

    </div>
  </main>
  <Footer />
</Layout>
