---
// src/components/layout/Header.astro
const links = [
  { label: 'About', href: '/#about' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Research', href: '/#research' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/#contact' },
];

const currentPath = Astro.url.pathname;
const isBlog = currentPath.startsWith('/blog');
---

<header class="fixed top-0 w-full z-50 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-50 hover:opacity-80 transition-opacity">
      Mayank Raj Jaiswal
    </a>
    
    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6">
      {links.map(link => {
        const isLinkActive = (link.href === '/blog/' && isBlog) || (link.href === '/' && currentPath === '/');
        return (
          <a 
            href={link.href}
            data-nav-link
            class={`nav-link text-sm font-medium transition-colors py-1.5 px-3 rounded-lg ${
              isLinkActive 
                ? 'text-blue-600 dark:text-blue-500 bg-slate-100/80 dark:bg-slate-900/80 font-semibold' 
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-50 hover:bg-slate-100/50 dark:hover:bg-slate-900/50'
            }`}
          >
            {link.label}
          </a>
        );
      })}
      
      <!-- Theme Toggle Button -->
      <button 
        id="theme-toggle" 
        class="p-2 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-50 rounded-lg hover:bg-slate-100/50 dark:hover:bg-slate-900/50 transition-colors cursor-pointer" 
        aria-label="Toggle Dark Mode"
      >
        <svg id="sun-icon" class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="M4.93 4.93l1.41 1.41"></path>
          <path d="M17.66 17.66l1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="M6.34 17.66l-1.41 1.41"></path>
          <path d="M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg id="moon-icon" class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <a href="/#contact" class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-500 rounded-lg shadow-sm hover:shadow transition-all">
        Connect
      </a>
    </nav>

    <!-- Mobile Navigation Controls -->
    <div class="flex items-center gap-2 md:hidden">
      <!-- Theme Toggle (Mobile) -->
      <button 
        id="theme-toggle-mobile" 
        class="p-2 text-slate-600 dark:text-slate-400 rounded-lg cursor-pointer" 
        aria-label="Toggle Dark Mode"
      >
        <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="M4.93 4.93l1.41 1.41"></path>
          <path d="M17.66 17.66l1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="M6.34 17.66l-1.41 1.41"></path>
          <path d="M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Mobile Menu Hamburger -->
      <button id="mobile-menu-btn" class="p-2 text-slate-600 dark:text-slate-400 rounded-lg cursor-pointer" aria-label="Toggle Menu" aria-expanded="false" aria-controls="mobile-drawer">
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Sliding Menu Overlay Scrim -->
  <div id="mobile-drawer-scrim" class="fixed inset-0 z-40 bg-slate-950/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"></div>

  <!-- Mobile Drawer Sliding Menu Panel -->
  <!--
    `inert` keeps the off-screen drawer out of the tab order and the a11y tree
    while closed. Without it the 8 controls inside stay keyboard-focusable and a
    keyboard user tabs into an invisible menu (WCAG 2.4.3 / 2.4.7).
    Toggled in openMenu()/closeMenu().
  -->
  <div id="mobile-drawer" inert aria-hidden="true" class="fixed top-0 right-0 bottom-0 z-50 w-[280px] bg-white dark:bg-slate-950 border-l border-slate-200/80 dark:border-slate-800/80 shadow-2xl translate-x-full transition-transform duration-300 ease-out">
    <div class="p-6 flex flex-col h-full justify-between font-sans">
      <div class="flex flex-col gap-6">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/60 pb-4">
          <span class="text-xs font-bold uppercase tracking-widest text-slate-600 dark:text-slate-400">Navigation</span>
          <!-- Dedicated Drawer Close Trigger -->
          <button id="mobile-drawer-close" class="p-2 text-slate-500 hover:text-slate-950 dark:text-slate-400 dark:hover:text-slate-50 rounded-lg cursor-pointer" aria-label="Close Menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"></line><line x1="6" x2="18" y1="6" y2="18"></line></svg>
          </button>
        </div>
        
        <nav class="flex flex-col gap-4">
          {links.map(link => {
            const isLinkActive = (link.href === '/blog/' && isBlog) || (link.href === '/' && currentPath === '/');
            return (
              <a 
                href={link.href}
                data-drawer-link
                class={`text-base font-semibold py-2.5 transition-colors border-b border-slate-50 dark:border-slate-900/20 ${
                  isLinkActive 
                    ? 'text-blue-600 dark:text-blue-500' 
                    : 'text-slate-600 dark:text-slate-400 hover:text-slate-950 dark:hover:text-slate-50'
                }`}
              >
                {link.label}
              </a>
            );
          })}
        </nav>
      </div>
      <a href="/#contact" data-drawer-link class="w-full text-center px-4 py-3.5 text-base font-bold text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-500 rounded-xl shadow-md">
        Connect
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const setupHeaderLogic = () => {
    // 1. Mobile Menu Toggling with Springy Side Drawer
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const mobileScrim = document.getElementById('mobile-drawer-scrim');
    const mobileClose = document.getElementById('mobile-drawer-close');
    const drawerLinks = document.querySelectorAll('[data-drawer-link]');

    const openMenu = () => {
      if (!mobileDrawer || !mobileScrim) return;
      mobileDrawer.classList.remove('translate-x-full');
      mobileDrawer.classList.add('translate-x-0');
      mobileDrawer.removeAttribute('inert');
      mobileDrawer.removeAttribute('aria-hidden');
      mobileScrim.classList.remove('opacity-0', 'pointer-events-none');
      mobileScrim.classList.add('opacity-100', 'pointer-events-auto');
      mobileMenuBtn?.setAttribute('aria-expanded', 'true');
      // Move focus into the drawer so keyboard users land on the close button.
      mobileClose?.focus();
    };

    const closeMenu = () => {
      if (!mobileDrawer || !mobileScrim) return;
      mobileDrawer.classList.add('translate-x-full');
      mobileDrawer.classList.remove('translate-x-0');
      mobileScrim.classList.add('opacity-0', 'pointer-events-none');
      mobileScrim.classList.remove('opacity-100', 'pointer-events-auto');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');

      // Restore focus BEFORE going inert. WebKit clears focus the instant the
      // inert attribute lands, which discards a later .focus() call and strands
      // keyboard users on <body>.
      if (document.activeElement instanceof Node && mobileDrawer.contains(document.activeElement)) {
        mobileMenuBtn?.focus();
      }

      // Re-hide from keyboard and assistive tech once closed.
      mobileDrawer.setAttribute('inert', '');
      mobileDrawer.setAttribute('aria-hidden', 'true');
    };

    if (mobileMenuBtn && mobileDrawer && mobileScrim) {
      mobileMenuBtn.removeEventListener('click', openMenu);
      mobileMenuBtn.addEventListener('click', openMenu);
      
      mobileClose?.removeEventListener('click', closeMenu);
      mobileClose?.addEventListener('click', closeMenu);

      mobileScrim.removeEventListener('click', closeMenu);
      mobileScrim.addEventListener('click', closeMenu);
      
      // Close drawer when clicking any link
      drawerLinks.forEach(link => {
        link.removeEventListener('click', closeMenu);
        link.addEventListener('click', closeMenu);
      });

      // Press Escape key to close mobile drawer menu
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !mobileDrawer.classList.contains('translate-x-full')) {
          closeMenu();
          mobileMenuBtn?.focus();
        }
      });
    }

    // 2. Theme Toggle Sync
    const desktopToggle = document.getElementById('theme-toggle');
    const mobileToggle = document.getElementById('theme-toggle-mobile');

    const handleThemeToggle = () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    };

    if (desktopToggle) {
      desktopToggle.removeEventListener('click', handleThemeToggle);
      desktopToggle.addEventListener('click', handleThemeToggle);
    }
    if (mobileToggle) {
      mobileToggle.removeEventListener('click', handleThemeToggle);
      mobileToggle.addEventListener('click', handleThemeToggle);
    }

    // 3. Scroll Active State Observer
    const navLinks = document.querySelectorAll('[data-nav-link]');

    // Only observe sections that a nav link actually points at. Homepage has
    // several sections (simulator, media, recognition, timeline, ...) with no
    // corresponding nav item -- observing those too meant every scroll into
    // one of them matched no link and cleared the active state entirely.
    const trackedIds = new Set(
      [...navLinks]
        .map(link => link.getAttribute('href') || '')
        .filter(href => href.includes('#'))
        .map(href => href.substring(href.indexOf('#') + 1))
    );
    const sections = [...document.querySelectorAll('section[id]')].filter(
      section => trackedIds.has(section.getAttribute('id') || '')
    );

    if (sections.length === 0) return;

    const observerOptions = {
      root: null,
      rootMargin: '-20% 0px -60% 0px', // When the section occupies the central focal area
      threshold: 0.1
    };

    const observerCallback = (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach(link => {
            const href = link.getAttribute('href');
            // Safely extract the hash anchor (e.g. "/#about" -> "#about")
            const hash = href.includes('#') ? href.substring(href.indexOf('#')) : '';
            
            if (hash === `#${id}`) {
              link.classList.add('text-blue-600', 'dark:text-blue-500', 'bg-slate-100/80', 'dark:bg-slate-900/80', 'font-semibold');
              link.classList.remove('text-slate-600', 'dark:text-slate-400');
            } else {
              link.classList.remove('text-blue-600', 'dark:text-blue-500', 'bg-slate-100/80', 'dark:bg-slate-900/80', 'font-semibold');
              link.classList.add('text-slate-600', 'dark:text-slate-400');
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, observerOptions);
    sections.forEach(section => observer.observe(section));
    
    // Also handle direct clicks to highlight instantly without waiting for scroll debounce
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        navLinks.forEach(l => {
          l.classList.remove('text-blue-600', 'dark:text-blue-500', 'bg-slate-100/80', 'dark:bg-slate-900/80', 'font-semibold');
          l.classList.add('text-slate-600', 'dark:text-slate-400');
        });
        link.classList.add('text-blue-600', 'dark:text-blue-500', 'bg-slate-100/80', 'dark:bg-slate-900/80', 'font-semibold');
        link.classList.remove('text-slate-600', 'dark:text-slate-400');
      });
    });
  };

  // This script sits inside <Header>, which renders before <main> in the
  // document. Running setupHeaderLogic() immediately therefore parses at a
  // point where document.readyState is still 'loading' and every section
  // inside <main> not yet exists -- `document.querySelectorAll('section[id]')`
  // silently returned zero elements, so the scroll-spy observer was never
  // created at all. Deferring to DOMContentLoaded (a no-op if it already
  // fired) lets the mobile-drawer/theme-toggle wiring run as before while
  // fixing the scroll-spy's actual root cause.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeaderLogic);
  } else {
    setupHeaderLogic();
  }
</script>