---
// src/components/sections/Recognition.astro
import { recognitions } from '../../data/recognition';
---

{recognitions.length > 0 && (
  <section id="recognition" class="py-16 sm:py-24 md:py-32 bg-white dark:bg-slate-900 border-t border-slate-200/80 dark:border-slate-800/80 relative overflow-hidden">
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-indigo-500/5 dark:bg-indigo-500/5 rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-6">

      <div class="max-w-3xl mb-16">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50 mb-4">
          Advisory & Recognition
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
          Advisory roles, internal recognitions, and community contributions across a fifteen-year career.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recognitions.map(item => (
          <div data-glow class="bg-gradient-to-br from-white to-indigo-50/10 dark:from-slate-950 dark:to-slate-950/60 rounded-2xl p-6 border border-slate-200/80 dark:border-slate-800/80 flex items-start gap-4 hover:-translate-y-1 hover:border-blue-500/50 dark:hover:border-blue-500/30 transition-all duration-300 shadow-sm">
            <div class="w-12 h-12 rounded-xl bg-slate-50 dark:bg-slate-950 flex items-center justify-center shrink-0 border border-slate-100 dark:border-slate-800 shadow-inner">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900 dark:text-slate-50 leading-snug">{item.title}</h3>
              <p class="text-xs font-bold text-blue-600 dark:text-blue-400 mt-1 uppercase tracking-widest">{item.organization}</p>
              <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
)}
