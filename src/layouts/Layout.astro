---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  pubDate?: string;
  preloadImage?: string;
  tags?: string[];
}

const { title, description, ogType = 'website', pubDate, preloadImage, tags = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

/**
 * Content Security Policy, delivered in-document.
 *
 * GitHub Pages cannot send custom HTTP response headers, so vercel.json and
 * public/_headers are inert on the live site and this meta tag is the only
 * enforcement available. Keep all three in sync for a future host migration.
 *
 * Deliverable via <meta>:      Content-Security-Policy, Referrer-Policy.
 * NOT deliverable via <meta>:  Strict-Transport-Security (use Pages' "Enforce
 *   HTTPS"), X-Content-Type-Options (no meta form), and frame-ancestors /
 *   X-Frame-Options -- hence the inline frame-buster further down.
 *
 * `upgrade-insecure-requests` is emitted only for the real https:// site. It
 * rewrites every http:// URL to https://, which breaks `astro dev` and
 * `astro preview` (both serve plain HTTP on localhost): WebKit honours the
 * upgrade, fails to reach https://localhost:4321, and the page renders with no
 * CSS, no fonts and no service worker. Chromium and Firefox exempt localhost,
 * so the breakage is invisible there. Note `astro preview` builds in PROD mode,
 * so import.meta.env.PROD cannot distinguish it from a real deploy -- hence the
 * explicit PUBLIC_PLAYWRIGHT flag below.
 */
const cspDirectives = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self'",
  "img-src 'self' data:",
  "connect-src 'self' https://api.web3forms.com",
  "form-action 'self' https://api.web3forms.com",
  "base-uri 'self'",
  "object-src 'none'",
  "frame-src 'none'",
  "worker-src 'self'",
  "manifest-src 'self'",
];

// PUBLIC_PLAYWRIGHT=1 is set by the webServer command in playwright.config.ts,
// which serves the production build over plain HTTP on localhost. Everything
// else -- including the real deploy -- gets the directive.
// (Astro only exposes PUBLIC_*-prefixed vars to import.meta.env.)
if (!import.meta.env.PUBLIC_PLAYWRIGHT) {
  cspDirectives.push('upgrade-insecure-requests');
}

const csp = cspDirectives.join('; ');

// Helper to map blog tags to verified Wikipedia cryptographic entities (Linked Data/GEO)
const getArticleAbout = (tagsArray: string[] = []) => {
  const aboutList = [];
  const tagsLower = tagsArray.map(t => t.toLowerCase());
  
  if (tagsLower.some(t => ['cryptography', 'pki', 'post-quantum'].includes(t))) {
    aboutList.push({
      "@type": "Thing",
      "name": "Cryptography",
      "sameAs": "https://en.wikipedia.org/wiki/Cryptography"
    });
  }
  if (tagsLower.some(t => ['fido2', 'iam'].includes(t))) {
    aboutList.push({
      "@type": "Thing",
      "name": "FIDO Alliance",
      "sameAs": "https://en.wikipedia.org/wiki/FIDO_Alliance"
    });
  }
  if (tagsLower.some(t => ['samsung knox', 'mobile payments'].includes(t))) {
    aboutList.push({
      "@type": "Thing",
      "name": "Samsung Knox",
      "sameAs": "https://en.wikipedia.org/wiki/Samsung_Knox"
    });
  }
  if (tagsLower.some(t => ['hsm', 'cryptography'].includes(t))) {
    aboutList.push({
      "@type": "Thing",
      "name": "Hardware Security Module",
      "sameAs": "https://en.wikipedia.org/wiki/Hardware_security_module"
    });
  }
  return aboutList.length > 0 ? aboutList : undefined;
};

const personSchema = {
  "@context": "https://schema.org/",
  "@type": "Person",
  "@id": "https://mayankrajjaiswal.com/#person",
  "name": "Mayank Raj Jaiswal",
  "url": "https://mayankrajjaiswal.com/",
  // 2x portrait crop: schema.org consumers prefer a larger, correctly-framed
  // image than the 3:2 original, which crops awkwardly in square/portrait cards.
  "image": "https://mayankrajjaiswal.com/images/mayank-portrait-896.jpg",
  "jobTitle": "Enterprise Security Architect",
  "description": "Enterprise Security Architect specializing in Identity & Access Management, Cybersecurity, Artificial Intelligence, Cloud Security, and Enterprise Software Architecture.",
  "worksFor": {
    "@type": "Organization",
    "name": "Thales Group",
    "sameAs": [
      "https://en.wikipedia.org/wiki/Thales_Group",
      "https://www.thalesgroup.com"
    ]
  },
  "alumniOf": [
    {
      "@type": "EducationalOrganization",
      "name": "BITS Pilani",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Birla_Institute_of_Technology_and_Science,_Pilani",
        "https://www.bits-pilani.ac.in"
      ]
    },
    {
      "@type": "EducationalOrganization",
      "name": "IIT Kanpur",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Indian_Institute_of_Technology_Kanpur",
        "https://www.iitk.ac.in"
      ]
    }
  ],
  "educationalCredentialAwarded": [
    {
      "@type": "EducationalOccupationalCredential",
      "name": "M.Tech – Software Engineering",
      "recognizedBy": {
        "@type": "EducationalOrganization",
        "name": "BITS Pilani"
      }
    },
    {
      "@type": "EducationalOccupationalCredential",
      "name": "B.Tech – Computer Science & Engineering",
      "recognizedBy": {
        "@type": "EducationalOrganization",
        "name": "IIT Kanpur"
      }
    }
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "name": "AWS Certified Solutions Architect",
      "credentialCategory": "Professional Certification"
    },
    {
      "@type": "EducationalOccupationalCredential",
      "name": "Certified Payment Cryptography Specialist",
      "credentialCategory": "Professional Certification"
    }
  ],
  "knowsAbout": [
    "Identity & Access Management (IAM)",
    "Cybersecurity Architecture",
    "Zero Trust Security",
    "Cloud Security",
    "Cryptography & HSMs",
    "Artificial Intelligence",
    "FIDO2 & Passkeys",
    "OAuth 2.0 & OpenID Connect",
    "DevSecOps"
  ],
  // Every sameAs target must be a live, verifiable profile: Google uses these for
  // entity reconciliation, so a dead URL is a worse signal than a missing one.
  // An ORCID was removed here because the ID failed the ISO 7064 MOD 11-2 check
  // digit that every ORCID must satisfy. To re-add one, verify BOTH the checksum
  // and https://pub.orcid.org/v3.0/<id>/person first — tests/seo-schema.spec.ts
  // enforces this automatically.
  "sameAs": [
    "https://github.com/mayankrajjaiswal",
    "https://linkedin.com/in/mayankrajjaiswal"
  ]
};

// Published book. isbn/publisher/url are verified live (see WhatNext.md §3.1) --
// IEEE Xplore, River Publishers, and Amazon all resolve for this title.
const bookSchema = {
  "@context": "https://schema.org",
  "@type": "Book",
  "name": "Implementing Enterprise Cybersecurity with Open-Source Software and Standard Architecture",
  "author": { "@id": "https://mayankrajjaiswal.com/#person" },
  "publisher": {
    "@type": "Organization",
    "name": "River Publishers",
    "sameAs": "https://www.riverpublishers.com"
  },
  "isbn": "9788770224230",
  "datePublished": "2020-11",
  "url": "https://www.riverpublishers.com/book_details.php?book_id=950",
  "sameAs": [
    "https://www.riverpublishers.com/book_details.php?book_id=950",
    "https://ieeexplore.ieee.org/document/9514776"
  ]
};

const scholarlyArticleSchema = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  "author": { "@id": "https://mayankrajjaiswal.com/#person" },
  "publisher": { "@type": "Organization", "name": "IEEE" },
  "url": "https://ieeexplore.ieee.org/document/9514776",
  "sameAs": "https://ieeexplore.ieee.org/document/9514776"
};

const jsonLd = ogType === 'website' ? {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": personSchema,
  "description": "Professional Profile of Mayank Raj Jaiswal, Enterprise Security Architect."
} : personSchema;

const articleJsonLd = ogType === 'article' ? {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": title,
  "description": description,
  "image": new URL('/og-image.jpg', Astro.site)?.toString(),
  "datePublished": pubDate,
  "about": getArticleAbout(tags),
  "author": {
    "@type": "Person",
    "name": "Mayank Raj Jaiswal",
    "url": "https://mayankrajjaiswal.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Mayank Raj Jaiswal"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.toString()
  }
} : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/*
      Raster fallbacks. SVG favicons are unsupported by Safari's home-screen
      bookmark and by Android's PWA installer, which require PNGs -- an
      SVG-only manifest silently blocks the install prompt.
    */}
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Writing & Insights | Mayank Raj Jaiswal" href="/rss.xml" />
    {/*
      Preload the LCP portrait in the SAME format <picture> will choose, using
      imagesrcset + type so the browser negotiates AVIF/WebP/JPEG identically.
      A plain href preload would fetch a file the page then never uses.
    */}
    {preloadImage && (
      <>
        <link
          rel="preload"
          as="image"
          type="image/avif"
          imagesrcset="/images/mayank-portrait-448.avif 1x, /images/mayank-portrait-896.avif 2x"
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          type="image/webp"
          imagesrcset="/images/mayank-portrait-448.webp 1x, /images/mayank-portrait-896.webp 2x"
        />
      </>
    )}
    {/*
      Search-console verification: intentionally omitted. Placeholder values
      ("YOUR_..._KEY_HERE") for google-site-verification and msvalidate.01 were
      shipping to production, which verifies nothing and just adds noise. Add the
      real meta tag only once you have the key from Google Search Console / Bing
      Webmaster Tools -- DNS TXT verification is a cleaner alternative.
    */}

    <!-- PWA Installable Manifest & Theme Colors -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563eb" />

    <!-- Apple Mobile Web App Polish -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="MRJ Security" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Mayank Raj Jaiswal" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    {/* Declaring width/height/type lets consumers (LinkedIn, Slack, etc.) render
        the card without re-fetching the image to discover its dimensions. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Mayank Raj Jaiswal - Enterprise Security Architect" />
    {ogType === 'article' && <meta property="article:author" content="Mayank Raj Jaiswal" />}
    {ogType === 'article' && pubDate && <meta property="article:published_time" content={new Date(pubDate).toISOString()} />}
    <meta property="og:profile:first_name" content="Mayank" />
    <meta property="og:profile:last_name" content="Raj Jaiswal" />
    <meta property="og:profile:username" content="mayankrajjaiswal" />
    <meta property="og:profile:gender" content="male" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta name="twitter:image:alt" content="Mayank Raj Jaiswal - Enterprise Security Architect" />
    {/*
      twitter:site / twitter:creator intentionally omitted: no verified X/Twitter
      handle exists to attribute. Add both together once one does -- an
      unverified handle would misattribute the card to the wrong account.
    */}

    {/* See the `csp` constant above for the policy and its constraints. */}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    {/*
      Self-hosted variable fonts (see @font-face in src/styles/global.css).
      Preloaded because they are discovered late -- the browser only finds them
      after parsing the CSS. crossorigin is REQUIRED on font preloads even
      same-origin; without it the browser fetches the file twice.
      Geist is preloaded (used site-wide); JetBrains Mono is not, since it only
      appears in code blocks and tech tags below the fold.
    */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/geist-latin-var.woff2"
      crossorigin="anonymous"
    />

    <!--
      Anti-clickjacking fallback. Replaces X-Frame-Options / frame-ancestors,
      neither of which can be delivered from GitHub Pages. Runs before paint so
      a framing attacker never sees rendered content.
    -->
    <script is:inline>
      if (window.self !== window.top) {
        document.documentElement.style.display = 'none';
        window.top.location = window.self.location;
      }
    </script>

    <!-- Blocking Script to prevent Theme Flashing -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const theme = getTheme();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}
    {Astro.url.pathname === '/' && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(bookSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(scholarlyArticleSchema)} />
      </>
    )}

    {/*
      ── Analytics (not yet enabled) ───────────────────────────────────────────
      No provider is wired up, so the site currently has no traffic visibility.
      All three options below are cookieless and need no consent banner.

      To enable Cloudflare Web Analytics (free, unlimited):
        1. Add the site at dash.cloudflare.com -> Web Analytics, copy the token.
        2. Uncomment the script below and paste the token.
        3. Add to the CSP above: script-src ... https://static.cloudflareinsights.com
           and connect-src ... https://cloudflareinsights.com

      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "REPLACE_WITH_TOKEN"}'
      />

      Plausible (paid) — script-src + connect-src: https://plausible.io
      <script defer data-domain="mayankrajjaiswal.com" src="https://plausible.io/js/script.js" />

      GoatCounter (free) — script-src + connect-src: https://<code>.goatcounter.com
      <script defer data-goatcounter="https://REPLACE.goatcounter.com/count"
              src="//gc.zgo.at/count.js" />

      NOTE: the CSP is enforced via <meta http-equiv> above. Adding a script
      without updating script-src will cause the browser to silently block it.
      tests/csp.spec.ts fails on any CSP violation, so a mismatch is caught.
    */}
  </head>
  <body class="min-h-[100dvh] flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:font-bold focus:rounded-xl focus:shadow-lg focus:outline-none">
      Skip to content
    </a>
    <slot />

    <!-- Back to Top Button -->
    <button
      id="back-to-top"
      class="fixed bottom-6 right-6 z-40 p-3 rounded-full border border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 hover:border-blue-500/50 dark:hover:border-blue-500/30 shadow-lg hover:shadow-xl backdrop-blur-md transition-all duration-300 translate-y-4 opacity-0 pointer-events-none"
      aria-label="Back to Top"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="19" x2="12" y2="5"></line>
        <polyline points="5 12 12 5 19 12"></polyline>
      </svg>
    </button>

    <script is:inline>
      const setupBackToTop = () => {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;

        const handleScroll = () => {
          if (window.scrollY > 400) {
            btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
            btn.classList.add('opacity-100', 'translate-y-0');
          } else {
            btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            btn.classList.remove('opacity-100', 'translate-y-0');
          }
        };

        window.removeEventListener('scroll', handleScroll);
        window.addEventListener('scroll', handleScroll);

        btn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth',
          });
        });
      };

      setupBackToTop();
    </script>

    <!-- PWA Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then(registration => {
            console.log('ServiceWorker registered successfully with scope: ', registration.scope);
          }).catch(err => {
            console.warn('ServiceWorker registration failed: ', err);
          });
        });
      }
    </script>

    <!-- Card Spotlight Glow Listener -->
    <script is:inline>
      const setupSpotlightGlow = () => {
        const glowCards = document.querySelectorAll('[data-glow]');
        
        glowCards.forEach(card => {
          const handleMouseMove = (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            card.style.setProperty('--mouse-x', `${x}px`);
            card.style.setProperty('--mouse-y', `${y}px`);
          };
          
          card.removeEventListener('mousemove', handleMouseMove);
          card.addEventListener('mousemove', handleMouseMove);
        });
      };

      setupSpotlightGlow();
    </script>
  </body>
</html>
